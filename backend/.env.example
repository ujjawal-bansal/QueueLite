# ---- Core ----
NODE_ENV=development
PORT=3001

# Public URL of the frontend. Used for CORS and for patient tracking links.
FRONTEND_URL=http://localhost:5173

# Extra browser origins allowed to call the API, comma separated. Vercel serves
# the same app on preview hostnames, and a request from one of those is blocked
# by CORS in a way the browser reports only as "cannot reach the server".
ALLOWED_ORIGINS=

# This deployment serves exactly one clinic. Must match a clinics.slug row.
CLINIC_SLUG=dev-eye-care

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Staff auth ----
# Run: npm run generate-secrets
SESSION_SECRET=
# Run: npm run hash-passcode
STAFF_PASSCODE_HASH=
SESSION_TTL_HOURS=12

# Break-glass sign-in for the morning the desk cannot remember the passcode.
# Run `npm run generate-recovery`: it prints a code to keep at the desk and the
# hash to paste here. Leave unset and the recovery sign-in does not exist.
STAFF_RECOVERY_CODE_HASH=

# ---- Queue behaviour ----
# How many patients ahead trigger the "start heading over" reminder. On a
# hundred-patient day this is the message that matters - the turn notification
# alone arrives when the patient already needs to be in the room. 0 disables it.
REMINDER_LEAD_PATIENTS=3

# Wait-estimate fallback, used until the day has enough finished consults to
# measure the real pace from. The clinic row's avg_consult_minutes overrides it.
AVG_CONSULT_MINUTES=15

# Override the figure above with the pace measured from today's call-ins.
# Off by default: a handful of quick call-ins early in the day produces a
# confident-looking number that is far too optimistic, and the desk repeats it
# to patients. Turn on once the measured figure matches the room.
USE_MEASURED_PACE=false


# ---- Notifications ----
# console = log messages instead of sending (safe default for dev)
# whatsapp = send via WhatsApp Cloud API
NOTIFIER=console

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Any random string; must match what you enter in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_TOKEN_ISSUED=queue_token_issued
WHATSAPP_TEMPLATE_YOUR_TURN=queue_your_turn
# Leave empty until Meta approves the heads-up template; the reminder then
# simply stays off instead of failing a send on every call-in.
WHATSAPP_TEMPLATE_HEADS_UP=
WHATSAPP_TEMPLATE_LOCALE=en
WHATSAPP_COUNTRY_CODE=91
