# Secrets for the local Docker stack (docker compose up --build).
# Copy to docker/app.env and fill in both values. docker/app.env is git-ignored.
#
# Build the jar once (cd backend && ./mvnw package -DskipTests), then:
#   java -jar backend/target/queuelite-api.jar generate-secrets          -> SESSION_SECRET
#   java -jar backend/target/queuelite-api.jar hash-passcode <passcode>  -> STAFF_PASSCODE_HASH
# Wrap both values in single quotes: the hash contains $, which Compose would
# otherwise read as a variable.
# No local Java? Use the image instead:
#   docker run --rm --entrypoint java queuelite-java:local -jar /app/queuelite-api.jar generate-secrets
SESSION_SECRET=''
STAFF_PASSCODE_HASH=''
